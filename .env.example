# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_NAME="ID Card Generator"

# MongoDB
MONGODB_URI=mongodb://localhost:27017/idcard
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/id-studio?retryWrites=true&w=majority

# JWT — use long random strings in production (min 32 chars each)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long-random
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long-random
JWT_ACCESS_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN=30d

# Cookie
COOKIE_NAME=id_studio_token
COOKIE_REFRESH_NAME=id_studio_refresh
# Set to true in production (HTTPS only)
COOKIE_SECURE=false

# Super Admin Seed (used only by: npm run seed)
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=admin@idstudio.com
SUPERADMIN_PASSWORD=SuperSecurePassword123!

# SMTP (Phase E — password reset)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="ID Studio <noreply@yourdomain.com>"
# FRONTEND_URL=http://localhost:3000
